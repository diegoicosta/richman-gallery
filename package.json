{
  "name": "richman-gallery",
  "version": "1.0.0",
  "private": true,
  "description": "Responsive photo gallery with fullscreen viewer, multi-select, tags, likes and comments. No dependencies.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diegoicosta/richman-gallery.git"
  },
  "homepage": "https://diegoicosta.github.io/richman-gallery/",
  "main": "./dist/richman-gallery.esm.js",
  "module": "./dist/richman-gallery.esm.js",
  "types": "./dist/richman-gallery.d.ts",
  "exports": {
    ".": {
      "types": "./dist/richman-gallery.d.ts",
      "import": "./dist/richman-gallery.esm.js",
      "default": "./dist/richman-gallery.esm.js"
    },
    "./richman-gallery.css": "./src/richman-gallery.css"
  },
  "files": [
    "dist",
    "src/richman-gallery.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
